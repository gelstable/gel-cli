#!/usr/bin/env clitest --v0

include "../_include/common.cli.inc";

using tempdir;

$ cp -R $INITIAL_PWD/../../proj .
*

$ gel instance destroy -I inst2 --force
%EXIT any
*

cd proj/project3;

# Create instance
$ gel instance create inst2 default-branch-name --non-interactive
*

# Initialize project
$ gel project init --link --server-instance=inst2 --non-interactive
reject {
    # Reject any hooks that are not listed below
    ? hook (?!project.init.after|migration.apply.(before|after)|(schema|config).update.(before|after))[\w\.]+: %{GREEDYDATA}
}
*
! hook project.init.after: true
*
! hook migration.apply.before: true
*
! hook schema.update.before: true
*
! hook migration.apply.after: true
*
! hook schema.update.after: true
*
! hook config.update.before: true
*
! hook config.update.after: true
! Configuration applied.
*

$ gel project info --json
! {
!   "branch": "default-branch-name",
!   "instance-name": "inst2",
!   "root": "%{GREEDYDATA}",
!   "schema-dir": "%{GREEDYDATA}database_schema"
! }

# Switch to a new branch
$ gel branch switch --create --empty another
reject {
    # Reject any hooks that are not listed below
    ? hook (?!branch.switch.before|branch.switch.after|schema.update.before|schema.update.after)[\w\.]+: %{GREEDYDATA}
}
*
! hook branch.switch.before: true
*
! hook schema.update.before: true
*
! hook branch.switch.after: gel branch current --plain >> branch.log
*
! hook schema.update.after: true
*

# Verify branch log
$ cat branch.log
! another

# Merge branch
$ gel branch merge default-branch-name
reject {
    # Reject any hooks that are not listed below
    ? hook (?!migration.apply.before|schema.update.before|migration.apply.after|schema.update.after)[\w\.]+: %{GREEDYDATA}
}
*
! hook migration.apply.before: true
*
! hook schema.update.before: true
*
! hook migration.apply.after: true
*
! hook schema.update.after: true
*

# Wipe branch
$ gel branch wipe another --non-interactive
reject {
    # Reject any hooks that are not listed below
    ? hook (?!branch.wipe.before|schema.update.before|branch.wipe.after|schema.update.after)[\w\.]+: %{GREEDYDATA}
}
*
! hook branch.wipe.before: true
*
! hook schema.update.before: true
*
! hook branch.wipe.after: true
*
! hook schema.update.after: true
*

# Switch back to default branch
$ gel branch switch default-branch-name
reject {
    # Reject any hooks that are not listed below
    ? hook (?!branch.switch.before|schema.update.before|branch.switch.after|schema.update.after)[\w\.]+: %{GREEDYDATA}
}
*
! hook branch.switch.before: true
*
! hook schema.update.before: true
*
! hook branch.switch.after: gel branch current --plain >> branch.log
*
! hook schema.update.after: true
*

# Verify branch log again
$ cat branch.log
! another
! default-branch-name

# Branch switch with --instance naming the linked instance runs hooks
$ gel --instance=inst2 branch switch another
*
! hook branch.switch.before: true
*
! hook branch.switch.after: gel branch current --plain >> branch.log
*

# Test branch switch with --skip-hooks flag
$ gel --skip-hooks branch switch default-branch-name
reject {
    ! hook %{GREEDYDATA}
}
*

# Test branch switch with GEL_SKIP_HOOKS environment variable
$ GEL_SKIP_HOOKS=1 gel branch switch another
reject {
    ! hook %{GREEDYDATA}
}
*
$ GEL_SKIP_HOOKS=1 gel branch switch default-branch-name
reject {
    ! hook %{GREEDYDATA}
}
*

# Test config update hooks
$ gel sync
reject {
    # Reject any hooks that are not listed below
    ? hook (?!config.update.(before|after))[\w\.]+: %{GREEDYDATA}
}
*
! hook config.update.before: true
*
! hook config.update.after: true
! Project is now in sync.

# Test config update with --skip-hooks flag
$ gel --skip-hooks sync
reject {
    ! hook %{GREEDYDATA}
}
*
! Project is now in sync.

# Test config update with GEL_SKIP_HOOKS environment variable
$ GEL_SKIP_HOOKS=1 gel sync
reject {
    ! hook %{GREEDYDATA}
}
*
! Project is now in sync.

# Apply a migration through the default project connection: all hooks run.
$ printf 'module default { type HooksDefault; }\n' > database_schema/hooks_default.gel
$ gel migration create --non-interactive
*
$ gel migration apply
*
! hook migration.apply.before: true
*
! hook schema.update.before: true
*
! hook migration.apply.after: true
*
! hook schema.update.after: true
*
$ gel query 'select count(default::HooksDefault)'
! 0

# An unlinked explicit instance applies the migration without project hooks.
$ gel instance destroy -I hooks_external --force
%EXIT any
*
$ gel instance create hooks_external --non-interactive
*
$ printf 'module default { type HooksExternal; }\n' > database_schema/hooks_external.gel
$ gel migration create --non-interactive
*
$ gel --instance=hooks_external migration apply
reject {
    ! hook %{GREEDYDATA}
}
*
$ gel --instance=hooks_external query 'select count(default::HooksExternal)'
! 0

# Keep the linked instance at the latest migration before creating another.
$ gel migration apply
*

# Naming the linked instance explicitly still runs project hooks.
$ printf 'module default { type HooksLinkedArg; }\n' > database_schema/hooks_linked_arg.gel
$ gel migration create --non-interactive
*
$ gel --instance=inst2 migration apply
*
! hook migration.apply.before: true
*
! hook migration.apply.after: true
*

$ printf 'module default { type HooksLinkedEnv; }\n' > database_schema/hooks_linked_env.gel
$ gel migration create --non-interactive
*
$ GEL_INSTANCE=inst2 gel migration apply
*
! hook migration.apply.before: true
*
! hook migration.apply.after: true
*

# Commands that always use the linked instance keep their hooks.
$ GEL_INSTANCE=hooks_external gel sync
*
! hook config.update.before: true
*

# An instance selected through the environment also leaves project context.
$ printf 'module default { type HooksEnvTarget; }\n' > database_schema/hooks_env_target.gel
$ gel migration create --non-interactive
*
$ GEL_INSTANCE=hooks_external gel migration apply
reject {
    ! hook %{GREEDYDATA}
}
*
$ gel --instance=hooks_external query 'select count(default::HooksEnvTarget)'
! 0

$ gel migration apply
*

# The global flag also works after the migration subcommand.
$ printf 'module default { type HooksFlag; }\n' > database_schema/hooks_flag.gel
$ gel migration create --non-interactive
*
$ gel migration apply --skip-hooks
reject {
    ! hook %{GREEDYDATA}
}
*
$ gel query 'select count(default::HooksFlag)'
! 0

# Both true values of the environment switch suppress before and after hooks.
$ printf 'module default { type HooksEnvOne; }\n' > database_schema/hooks_env_one.gel
$ gel migration create --non-interactive
*
$ GEL_SKIP_HOOKS=1 gel migration apply
reject {
    ! hook %{GREEDYDATA}
}
*
$ gel query 'select count(default::HooksEnvOne)'
! 0

$ printf 'module default { type HooksEnvTrue; }\n' > database_schema/hooks_env_true.gel
$ gel migration create --non-interactive
*
$ GEL_SKIP_HOOKS=true gel migration apply
reject {
    ! hook %{GREEDYDATA}
}
*
$ gel query 'select count(default::HooksEnvTrue)'
! 0

$ gel instance destroy -I hooks_external --force
*
